{
	"cli": {
		"version": ">= 5.0.0"
	},
	"build": {
		"development": {
			"developmentClient": true,
			"distribution": "internal"
		},
		"preview": {
			"distribution": "internal",
			"android": {
				"buildType": "apk"
			},
			"env": {
				"EXPO_PUBLIC_CONVEX_URL": "https://quixotic-hound-619.convex.cloud",
				"EXPO_PUBLIC_CONVEX_SITE_URL": "https://quixotic-hound-619.convex.site"
			}
		},
		"production": {
			"android": {
				"buildType": "app-bundle"
			},
			"autoIncrement": true,
			"env": {
				"EXPO_PUBLIC_CONVEX_URL": "https://quixotic-hound-619.convex.cloud",
				"EXPO_PUBLIC_CONVEX_SITE_URL": "https://quixotic-hound-619.convex.site"
			}
		}
	},
	"submit": {
		"production": {
			"android": {
				"serviceAccountKeyPath": "./google-service-account.json",
				"track": "internal"
			}
		}
	}
}
